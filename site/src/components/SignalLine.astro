---
// A thin wave between sections, in the app's spectrum. It lies nearly flat and swells with scroll
// speed, the way the preview's wave follows your voice. Reduce Motion leaves it still.
const id = `signal-${Math.random().toString(36).slice(2, 8)}`;
---

<div class="signal" aria-hidden="true">
  <svg viewBox="0 0 1200 48" preserveAspectRatio="none">
    <defs>
      <linearGradient id={id} x1="0" x2="1" y1="0" y2="0">
        <stop offset="0" stop-color="#ff3b30" stop-opacity="0" />
        <stop offset="0.12" stop-color="#ff9500" />
        <stop offset="0.3" stop-color="#ffcc00" />
        <stop offset="0.48" stop-color="#34c759" />
        <stop offset="0.66" stop-color="#32ade6" />
        <stop offset="0.84" stop-color="#007aff" />
        <stop offset="1" stop-color="#af52de" stop-opacity="0" />
      </linearGradient>
    </defs>
    <path d="M0 24 L1200 24" stroke={`url(#${id})`} />
  </svg>
</div>

<style>
  .signal {
    position: relative;
    z-index: 1;
    width: min(100% - 32px, var(--content-wide));
    height: 48px;
    margin: 0 auto;
    opacity: 0.55;
  }
  .signal svg { width: 100%; height: 100%; display: block; overflow: visible; }
  .signal path { fill: none; stroke-width: 1.5; vector-effect: non-scaling-stroke; stroke-linecap: round; }
  :global([data-theme='light']) .signal { opacity: 0.7; }
</style>

<script>
  // One loop drives every signal line on the page. Energy comes from scroll speed and decays.
  let started = false;

  function start() {
    if (started) return;
    started = true;
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
    let energy = 0;
    let lastY = window.scrollY;
    let lastT = performance.now();
    const visible = new Set<SVGPathElement>();
    const io = new IntersectionObserver((entries) => {
      for (const e of entries) {
        const path = e.target.querySelector('path') as SVGPathElement | null;
        if (!path) continue;
        e.isIntersecting ? visible.add(path) : visible.delete(path);
      }
    });
    const observe = () => document.querySelectorAll('.signal').forEach((el) => io.observe(el));
    observe();
    document.addEventListener('astro:page-load', observe);

    window.addEventListener('scroll', () => {
      const now = performance.now();
      const v = Math.abs(window.scrollY - lastY) / Math.max(now - lastT, 1);
      energy = Math.min(1, energy + v * 0.08);
      lastY = window.scrollY;
      lastT = now;
    }, { passive: true });

    const draw = (t: number) => {
      if (!reduce.matches && visible.size) {
        energy *= 0.95;
        const amp = 1.2 + energy * 15;
        let d = '';
        for (let x = 0; x <= 1200; x += 12) {
          const u = x / 1200;
          const env = Math.sin(Math.PI * u);
          const y = 24 + env * amp * (
            Math.sin(u * 19 + t * 0.0021) * 0.55 +
            Math.sin(u * 31 - t * 0.0016) * 0.3 +
            Math.sin(u * 7 + t * 0.0009) * 0.15);
          d += (x === 0 ? 'M' : 'L') + x + ' ' + y.toFixed(2);
        }
        visible.forEach((path) => path.setAttribute('d', d));
      }
      requestAnimationFrame(draw);
    };
    requestAnimationFrame(draw);
  }

  document.addEventListener('astro:page-load', start);
</script>
