---
import fs from 'node:fs';
import path from 'node:path';
import BaseLayout from '../layouts/BaseLayout.astro';
import WaveTitle from '../components/WaveTitle.astro';
import Said from '../components/Said.astro';
import Screen from '../components/Screen.astro';

// The newest release in the appcast, so the page never names a version that isn't published.
const appcast = fs.readFileSync(path.join(process.cwd(), 'public/appcast.xml'), 'utf8');
const version = appcast.match(/<sparkle:shortVersionString>([^<]+)</)?.[1];

const download = 'https://github.com/RichardStoker-USDA/SideWave/releases/latest/download/SideWave.dmg';
const repo = 'https://github.com/RichardStoker-USDA/SideWave';

const sections = [
  {
    id: 'anywhere',
    said: '{so} it types into {like} the app you\'re already using',
    wrote: 'It types into the app you\'re already using.',
    body: ['Press your hotkey in any text field and talk. The preview shows a fast draft in gray while you speak. SideWave remembers the field you started in and finds it again before it pastes.'],
    screen: { name: 'preview-draft', alt: 'The SideWave preview mid-sentence, with the live draft in gray.' },
  },
  {
    id: 'switch',
    said: 'look something up mid-sentence {um} the text still goes where you started',
    wrote: 'Look something up mid-sentence. The text still goes where you started.',
    body: [
      'Switch apps while you talk. When you finish, SideWave brings back the window you started in and pastes there.',
      'If that app closed or the paste is blocked, the text is saved to History. Escape stops without pasting and keeps the text on Home.',
    ],
    screen: { name: 'history', alt: 'SideWave History with dictations sent to Slack, Mail, Terminal, Notes, and Messages.' },
  },
  {
    id: 'refine',
    said: 'refine {uh} removes filler words and {you know} fixes grammar',
    wrote: 'Refine removes filler words and fixes grammar.',
    body: [
      'Apple Intelligence or a Gemma 4 model refines the text on your Mac while you talk. Recognition confirms each stretch of speech and corrects the draft, then Refine fixes punctuation and grammar and drops filler words.',
      'Standard keeps your wording, Professional makes it formal, and Concise makes it shorter. As Spoken skips Refine.',
    ],
    screen: { name: 'preview-refined', alt: 'The preview with the refined text: "Quick update on the irrigation trial, we finished sampling plots 4 through 9 on Tuesday, and the soil moisture readings look consistent with last week."' },
  },
  {
    id: 'templates',
    said: 'templates turn {like} what you say into {um} a document',
    wrote: 'Templates turn what you say into a document.',
    body: [
      'Email, Instructions, AI Prompt, and Custom open a document window. Read it, edit it, or ask for a change by typing or speaking, like "make this a list."',
      'Pick an output language to speak in one language and paste in another.',
    ],
    screen: { name: 'document', alt: 'The SideWave document window with an email written from one dictation.' },
  },
  {
    id: 'jargon',
    said: '{so} teach it {um} your field\'s jargon',
    wrote: 'Teach it your field\'s jargon.',
    body: ['A glossary holds the names, acronyms, and species your work uses. Recognition checks for them in the audio, and Refine gets their spelling and meaning. Download a bundle from the catalog or make your own.'],
    screen: { name: 'vocabulary', alt: 'A SideWave glossary for field research with qPCR, evapotranspiration, and Brassica rapa.' },
  },
  {
    id: 'local',
    said: '{and} there\'s {like} no account and no analytics',
    wrote: 'No account and no analytics.',
    body: ['Speech recognition and Refine run on your Mac, so your speech and text aren\'t uploaded. SideWave goes online to download models, to fetch glossary bundles you add, and to check for updates if you allow it. Help > Data Transparency lists every download and update check.'],
  },
];
---

<BaseLayout title="SideWave: dictation for Mac">
  <main>
    <header class="hero wrap">
      <WaveTitle />
      <div class="lede">
        <Said as="p" said="{so} it's {um} dictation that runs on your Mac" wrote="Dictation that runs on your Mac." />
        <p class="intro">
          Click into a text field, press your hotkey, and talk. A preview shows your words while you
          speak, and when you finish, SideWave pastes the text where you started.
        </p>
        <a href={download} class="button" id="download-btn">
          <svg class="apple" width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.8-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M13 3.5c.73-.83 1.94-1.46 2.94-1.5.13 1.17-.34 2.35-1.04 3.19-.69.85-1.83 1.51-2.95 1.42-.15-1.15.41-2.35 1.05-3.11z"/>
          </svg>
          <span class="button-text">Download for Mac</span>
        </a>
        <p class="req">Free and open source. {version ? `Version ${version} needs` : 'Needs'} macOS 26 or later on Apple silicon.</p>
      </div>
      <Screen name="home" class="hero-shot" eager alt="SideWave Home with the template, Refine model, microphone, destination, and shortcut." />
    </header>

    {sections.map((s) => (
      <section class={`say wrap${s.screen ? '' : ' say-text'}`} id={s.id} aria-labelledby={`${s.id}-title`}>
        <div class="say-copy">
          <Said id={`${s.id}-title`} said={s.said} wrote={s.wrote} />
          {s.body.map((p) => <p class="body">{p}</p>)}
        </div>
        {s.screen && <Screen name={s.screen.name} class={`say-shot shot-${s.id}`} alt={s.screen.alt} />}
      </section>
    ))}

    <section class="closing wrap" aria-labelledby="get-title">
      <h2 id="get-title" class="closing-title">SideWave is free and open source.</h2>
      <p class="body">It needs a Mac with Apple silicon and macOS 26 or later. If you allow it, SideWave checks for a new version once a day and asks before installing it.</p>
      <p class="closing-links">
        <a href={download} class="button">Download for Mac</a>
        <a href={repo} class="text-link" target="_blank" rel="noopener noreferrer">Source on GitHub</a>
      </p>
    </section>
  </main>
</BaseLayout>

<style>
  main { position: relative; }
  .wrap { width: min(100% - 2 * var(--gutter), var(--page-width)); margin-inline: auto; }

  .hero { padding-top: calc(var(--nav-height) + 7vh); text-align: center; }
  .hero :global(.hero-title-wrap) { margin: 0 auto; }
  .hero :global(.hero-title) { font-size: clamp(4.4rem, 15vw, 13.5rem); }
  .lede { max-width: 620px; margin: 30px auto 0; }
  .lede :global(.said), .lede :global(.wrote) { margin-inline: auto; }
  .lede :global(.wrote) { font-size: clamp(1.9rem, 2.6vw + 0.6rem, 2.9rem); max-width: 19ch; }
  .intro { max-width: 50ch; margin: 18px auto 0; font-size: 1.0625rem; }
  .lede .button { margin-top: 30px; }
  .req { margin: 14px auto 0; font-size: 0.875rem; color: var(--text-tertiary); }
  .hero :global(.hero-shot) { max-width: 980px; margin: 72px auto 0; }

  .button {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    padding: 13px 22px;
    border-radius: 999px;
    background: var(--text-primary);
    color: var(--bg-primary);
    font-weight: 600;
    font-size: 1rem;
    line-height: 1;
    text-decoration: none;
    transition: transform 0.18s ease, background-color 0.3s ease;
  }
  .button:hover { color: var(--bg-primary); text-decoration: none; transform: translateY(-1px); }
  .button:active { transform: translateY(0); }
  .apple { margin-top: -2px; }

  .say {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: 72px;
    align-items: center;
    padding-top: 136px;
  }
  .say-text { grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); }
  .say-copy .body { max-width: 46ch; margin-top: 18px; }
  .say-copy :global(.said-wrote) + .body { margin-top: 24px; }
  .say :global(.shot-jargon) { max-width: 560px; justify-self: end; width: 100%; }

  .closing { padding: 150px 0 30px; }
  .closing-title {
    font-weight: 500;
    font-size: clamp(1.9rem, 2.6vw + 0.6rem, 2.9rem);
    letter-spacing: -0.02em;
    max-width: 19ch;
  }
  .closing .body { max-width: 52ch; margin-top: 16px; }
  .closing-links { display: flex; flex-wrap: wrap; align-items: center; gap: 14px 28px; margin-top: 30px; }
  .text-link { font-weight: 600; }

  @media (max-width: 820px) {
    .hero :global(.hero-shot) { margin-top: 52px; }
    .say, .say-text { grid-template-columns: 1fr; gap: 32px; padding-top: 96px; }
    .say :global(.shot-jargon) { justify-self: stretch; max-width: none; }
    .closing { padding-top: 110px; }
  }
</style>

<script>
  // On a Mac the button shows the Apple mark; elsewhere it says the app is for macOS.
  function initDownload() {
    const isMac = /mac/i.test(navigator.platform || '') || /macintosh/i.test(navigator.userAgent);
    if (isMac) return;
    document.querySelectorAll<HTMLElement>('#download-btn').forEach((btn) => {
      btn.querySelector('.apple')?.setAttribute('hidden', '');
      const text = btn.querySelector('.button-text');
      if (text) text.textContent = 'Download for macOS';
    });
  }

  // Refined lines settle the way the preview's words do: draft gray, a short pass of color, then
  // ink. Once per visit, never with Reduce Motion.
  function initRefine() {
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    let seen = false;
    try { seen = sessionStorage.getItem('sw-refined') === '1'; } catch {}
    if (seen) return;
    // Lines already on screen at load stay as they are; only the ones you scroll to settle.
    const lines = Array.from(document.querySelectorAll<HTMLElement>('[data-refine]'))
      .filter((l) => l.getBoundingClientRect().top > window.innerHeight);
    const hues = ['#ff9f0a', '#ffd60a', '#30d158', '#64d2ff', '#0a84ff', '#bf5af2'];
    lines.forEach((line) => {
      if (line.dataset.split) return;
      line.dataset.split = '1';
      const words = (line.textContent ?? '').trim().split(/\s+/);
      line.textContent = '';
      words.forEach((w, i) => {
        const span = document.createElement('span');
        span.className = 'rw';
        span.textContent = w;
        span.style.setProperty('--hue', hues[i % hues.length]);
        span.style.setProperty('--i', String(i));
        line.append(span, i < words.length - 1 ? ' ' : '');
      });
      line.classList.add('is-draft');
    });
    const io = new IntersectionObserver((entries) => {
      for (const e of entries) {
        if (!e.isIntersecting) continue;
        io.unobserve(e.target);
        e.target.classList.remove('is-draft');
        e.target.classList.add('is-refining');
      }
    }, { rootMargin: '0px 0px -12% 0px' });
    lines.forEach((l) => io.observe(l));
    try { sessionStorage.setItem('sw-refined', '1'); } catch {}
  }

  document.addEventListener('astro:page-load', () => { initDownload(); initRefine(); });
</script>

<style is:global>
  [data-refine] .rw { display: inline-block; }
  [data-refine].is-draft .rw { color: var(--text-draft); }
  [data-refine].is-refining .rw { animation: sw-refine 0.9s ease both; animation-delay: calc(var(--i) * 55ms + 80ms); }
  @keyframes sw-refine {
    0% { color: var(--text-draft); }
    35% { color: var(--hue); }
    100% { color: var(--text-primary); }
  }
</style>
