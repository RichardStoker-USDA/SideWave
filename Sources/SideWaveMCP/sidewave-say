#!/usr/bin/env python3
# sidewave-say: Send text to SideWave TTS via Unix socket.
# Usage: sidewave-say "Hello, this is a test."
# Returns immediately -- does not block the caller.

import socket, json, sys, os, tempfile

if len(sys.argv) < 2:
    print("Usage: sidewave-say 'text to speak'", file=sys.stderr)
    sys.exit(1)

text = " ".join(sys.argv[1:])
tempdir = tempfile.gettempdir()
sock_path_prod = os.path.join(tempdir, "sidewave-mcp.sock")
sock_path_dev = os.path.join(tempdir, "sidewave-mcp-dev.sock")

# Determine preferred path. Try dev first if execution context or file existence suggests it.
script_path = sys.argv[0]
if "dev" in script_path.lower() or "SideWave-Dev" in script_path or os.path.exists(sock_path_dev):
    sock_paths = [sock_path_dev, sock_path_prod]
else:
    sock_paths = [sock_path_prod, sock_path_dev]

connected = False
sock = None
for path in sock_paths:
    # Validate length to avoid OS connection/path limits (similar to sun_path bounds checking)
    if len(path.encode('utf-8')) > 103:
        continue
    try:
        sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        sock.settimeout(3)
        sock.connect(path)
        connected = True
        break
    except Exception:
        continue

if not connected or sock is None:
    print("sidewave-say: Could not connect to SideWave. Is it running?", file=sys.stderr)
    sys.exit(1)

try:
    # MCP initialize
    sock.sendall((json.dumps({
        "jsonrpc": "2.0", "id": 1, "method": "initialize",
        "params": {"protocolVersion": "2024-11-05", "capabilities": {},
                   "clientInfo": {"name": "sidewave-say", "version": "1.0"}}
    }) + "\n").encode())

    # Read init response
    r = b""
    try:
        while b"\n" not in r:
            chunk = sock.recv(65536)
            if not chunk:
                break  # peer closed; recv() returns b"" with no exception
            r += chunk
    except socket.timeout:
        pass

    # Send initialized notification
    sock.sendall((json.dumps({
        "jsonrpc": "2.0", "method": "notifications/initialized", "params": {}
    }) + "\n").encode())

    # Call speak tool
    sock.sendall((json.dumps({
        "jsonrpc": "2.0", "id": 2, "method": "tools/call",
        "params": {"name": "speak", "arguments": {"text": text}}
    }) + "\n").encode())

    # Read response
    r2 = b""
    try:
        while b"\n" not in r2:
            chunk = sock.recv(65536)
            if not chunk:
                break  # peer closed; recv() returns b"" with no exception
            r2 += chunk
    except socket.timeout:
        pass

    sock.close()
except Exception as e:
    print(f"sidewave-say: {e}", file=sys.stderr)
    if sock:
        sock.close()
    sys.exit(1)
